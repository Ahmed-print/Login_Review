def reset_password(): 
    # This function is for resetting the user's password in the forgot password window
    username = forgot_email.value # The first thing the user is asked to enter is their username, which is taken from the forgot_email TextBox
    new_password = forgot_newpw.value # The user is then asked to enter their new password, which is taken from the forgot_newpw TextBox
    confirm_new_password = forgot_confirm_newpw.value # The user must confirm their new password, which is taken from the forgot_confirm_newpw TextBox

    if username == "": # Checks if the username field is empty, if it is, show an error message
        info("Error", "Please enter your username")
    elif new_password == "": # Checks if the new password field is empty, if it is, show an error message
        info("Error", "Please enter your new password")
    elif confirm_new_password == "": # Checks if the confirm new password field is empty, if it is, show an error message
        info("Error", "Please confirm your new password")
    elif new_password != confirm_new_password: # Checks if the new password and confirm new password match, if not, show an error message
        info("Error", "Passwords do not match")
    else: # If all the above checks pass, the password is reset and the user is shown a success message
        query = "SELECT * FROM User WHERE user_name = ?"
        rows = query_database(database_file, query, (username,))

        if len(rows) == 0: # Chekcs if the username exists in the database, if not, show an error message
            info("Error", "Username not found")
        else:
            update_query = "UPDATE User SET user_password = ? WHERE user_name = ?" # If the username exists, the password is updated in the database
            execute_sql(database_file, update_query, (new_password, username))
            info("Success", "Password reset successfully")
            forgot_newpw.clear() # Clears the new password and confirm new password fields in the forgot password window
            forgot_confirm_newpw.clear()
            forgot_window.hide()
            app.show() # Navigates back to the login window after the password has been reset successfully
